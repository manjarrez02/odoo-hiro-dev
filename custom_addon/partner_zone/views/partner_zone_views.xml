<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Partner Zone Form View -->
    <record id="res_partner_zone_view_form" model="ir.ui.view">
        <field name="name">res.partner.zone.form</field>
        <field name="model">res.partner.zone</field>
        <field name="arch" type="xml">
            <form string="Zona">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Nombre de la zona"/>
                        <h1>
                            <field name="name" placeholder="Ej. Zona Norte, Centro, Ruta 1..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="Ej. Z-01"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción" name="description">
                            <field name="description" placeholder="Detalles de la cobertura, colonias o referencias de la zona..."/>
                        </page>
                        <page string="Contactos asignados" name="partners">
                            <field name="partner_ids" readonly="1">
                                <tree>
                                    <field name="display_name" string="Nombre"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="city"/>
                                    <field name="category_id" widget="many2many_tags" optional="hide"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Partner Zone Tree View -->
    <record id="res_partner_zone_view_tree" model="ir.ui.view">
        <field name="name">res.partner.zone.tree</field>
        <field name="model">res.partner.zone</field>
        <field name="arch" type="xml">
            <tree string="Catálogo de Zonas" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="partner_count" string="Contactos"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Partner Zone Search View -->
    <record id="res_partner_zone_view_search" model="ir.ui.view">
        <field name="name">res.partner.zone.search</field>
        <field name="model">res.partner.zone</field>
        <field name="arch" type="xml">
            <search string="Buscar zonas">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <separator/>
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Partner Zone Window Action -->
    <record id="res_partner_zone_action" model="ir.actions.act_window">
        <field name="name">Catálogo de Zonas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner.zone</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="res_partner_zone_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva zona
            </p>
            <p>
                Define zonas geográficas, rutas o sectores para asignar a tus clientes y contactos.
            </p>
        </field>
    </record>

    <!-- Menu Item in Contacts > Configuration -->
    <menuitem id="menu_res_partner_zone"
              name="Zonas"
              action="res_partner_zone_action"
              parent="contacts.res_partner_menu_config"
              sequence="3"/>
</odoo>
