<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_inherit_customer_screen" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.customer.screen</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_technical_section']" position="after">
                <h2>Customer Display</h2>
                <div class="row mt16 o_settings_container" id="pos_customer_display">
                    <div class="col-xs-12 col-md-6 o_setting_box" id="customer_display">
                        <div class="o_setting_left_pane">
                            <field name="pos_customer_display"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_customer_display" string="Customer Display"/>
                            <div class="text-muted">
                                Customer Display
                            </div>
                            <div class="content-group mt16" attrs="{'invisible' : [('pos_customer_display', '=', False)]}">
                                <div class="row mt16">
                                    <label string="Image Time Interval" for="pos_image_interval"
                                           class="col-md-3 o_light_label" style="width: 150px;"/>
                                    <field name="pos_image_interval"/>
                                </div>
                                <div class="text-muted" id="image_interval">
                                    Time interval calculate based on seconds
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-xs-12 col-md-6 o_setting_box" id="customer_display"
                         attrs="{'invisible' : [('pos_customer_display', '=', False)]}">
                        <div class="o_setting_left_pane">
                            <field name="pos_enable_customer_rating"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_enable_customer_rating" string="Rating"/>
                            <div class="text-muted">
                                Customer Display Rating
                            </div>
                        </div>
                        <div class="o_setting_left_pane">
                            <field name="pos_enable_signature"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_enable_signature"/>
                            <div class="text-muted">
                                Stored in POS Order.
                            </div>
                        </div>
                        <div class="o_setting_left_pane">
                            <field name="pos_create_customer"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_create_customer" string="Create Customer"/>
                            <div class="text-muted">
                                Create Customer From Customer Display.
                            </div>
                        </div>
                        <br/>
                        <br/>
                    </div>
                    <div attrs="{'invisible' : [('pos_customer_display', '=', False)]}">
                        <label for="pos_customer_display_details_ids" string="Advertise Image"/>
                        <div class="text-muted">
                            Add image in below list.
                        </div>
                        <field name="pos_customer_display_details_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="image"/>
                            </tree>
                        </field>
                    </div>
                    <div attrs="{'invisible' : [('pos_customer_display', '=', False)]}">
                        <label for="pos_ad_video_ids" string="Advertise Video"/>
                        <div class="text-muted">
                            Add youtube id in below list.
                        </div>
                        <field name="pos_ad_video_ids">
                            <tree editable="bottom">
                                <field name="name"/>
                                <field name="is_youtube_video"/>
                                <field name="video_id" attrs="{'invisible': [('is_youtube_video', '=', False)]}"/>
                                <field name="local_video_id" attrs="{'invisible': [('is_youtube_video', '=', True)]}"/>
                            </tree>
                        </field>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="order_inherited_form_view" model="ir.ui.view">
        <field name="name">pos.order.inherited.view</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <field name="pricelist_id" position="after">
                <field name="rating" readonly="1" widget="priority"/>
                <field name="signature" widget="image" options='{"size": [220, 150]}'/>
            </field>
        </field>
    </record>

</odoo>