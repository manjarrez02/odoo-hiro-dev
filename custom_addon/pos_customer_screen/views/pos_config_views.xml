<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>

        <record id="advideo_pos_config_inherited_view_form" model="ir.ui.view">
            <field name="name">advideo.pos.config.inherited.view.form</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@groups='base.group_system']" position="before">
                    <div class="col-12 col-lg-6 o_setting_box" id="customer_display">
                        <div class="o_setting_left_pane">
                            <field name="customer_display"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="customer_display" string="Customer Display"/>
                            <div class="text-muted mb16">
                                Allow to use the Customer Display
                            </div>
                        </div>
                    </div>
                    <div attrs="{'invisible' : [('customer_display', '=', False)]}">
                        <div>
                            <label for="customer_display_details_ids" string="Advertise Image"/>
                            <div class="text-muted">
                                Add image in below list.
                            </div>
                            <field name="customer_display_details_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="image"/>
                                </tree>
                            </field>
                        </div>
                    </div>
                    <div attrs="{'invisible' : [('customer_display', '=', False)]}">
                        <div>
                            <label for="ad_video_ids" string="Advertise Video"/>
                            <div class="text-muted">
                                Add youtube id in below list.
                            </div>
                            <field name="ad_video_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="is_youtube_video"/>
                                    <field name="video_id" attrs="{'invisible': [('is_youtube_video', '=', False)]}"/>
                                    <field name="local_video_id" attrs="{'invisible': [('is_youtube_video', '=', True)]}"/>
                                </tree>
                            </field>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>

</odoo>