<odoo>
    <record id="view_route_history_tree" model="ir.ui.view">
        <field name="name">route.history.tree</field>
        <field name="model">route.history</field>
        <field name="arch" type="xml">
            <tree string="Route History">
                <field name="sequence_name"/>
                <field name="name"/>
                <field name="origin_id"/>
                <field name="final_id"/>
                <field name="departure_time"/>
                <field name="optimize"/>
                <field name="avoid_tolls"/>
                <field name="avoid_highways"/>
                <field name="avoid_ferries"/>
                <field name="total_duration_display"/>
            </tree>
        </field>
    </record>

    <record id="view_route_history_form" model="ir.ui.view">
        <field name="name">route.history.form</field>
        <field name="model">route.history</field>
        <field name="arch" type="xml">
            <form string="Route History">
                <sheet>
                    <group>
                        <group>
                            <field name="sequence_name" readonly="1"/>
                            <field name="name" readonly="1"/>
                            <field name="origin_id" readonly="1"/>
                            <field name="final_id" readonly="1"/>
                            <field name="departure_time" readonly="1"/>
                        </group>
                        <group>
                            <field name="optimize" readonly="1"/>
                            <field name="avoid_tolls" readonly="1"/>
                            <field name="avoid_highways" readonly="1"/>
                            <field name="avoid_ferries" readonly="1"/>
                            <field name="total_duration_display" readonly="1"/>
                            <field name="google_url" widget="url" readonly="1"/>
                        </group>
                    </group>

                    <group string="Stops">
                        <field name="line_ids" readonly="1">
                            <tree>
                                <field name="sequence"/>
                                <field name="partner_id"/>
                                <field name="leg_duration_display" string="Time from previous point"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </group>

                    <group>
                        <field name="note" readonly="1"/>
                    </group>
                </sheet>

                <footer>
                    <button string="Modify / Reoptimize"
                            type="object"
                            name="action_generate_route"
                            class="btn-primary"/>
                    <button string="Open Map"
                            type="object"
                            name="action_open_map"
                            class="btn-secondary"/>
                    <button string="Close"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_route_history" model="ir.actions.act_window">
        <field name="name">Route History</field>
        <field name="res_model">route.history</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_route_history"
              name="Route History"
              action="action_route_history"
              sequence="30"
              groups="base.group_user"/>
</odoo>