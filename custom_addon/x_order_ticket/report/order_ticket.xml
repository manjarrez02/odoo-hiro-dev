<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- QWeb Reports -->
    <record id="report_order_print_thermal_so_action" model="ir.actions.report">
        <field name="name">Ticket de cotización/orden</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">x_order_ticket.order_ticket</field>
        <field name="report_file">x_order_ticket.order_ticket</field>
        <field name="print_report_name">(object._get_report_base_filename())
        </field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_roll_paper"/>
    </record>
    <!-- Template of Thermal invoice report -->
    <template id="order_ticket">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="doc">
                    <t t-set="lang" t-value="doc.partner_id.lang"/>
                    <div class="thermal-report-page">
                        <div style = "text-align: center;">
                            <img style="margin-top:0; text-align: center; max-width: 288px; max-height: 144px; width: auto; height: auto;" src='/web/binary/company_logo'/>
                        </div>
                        <div style="text-align: center; font-size: 13px; margin-top: 0px">
                                <span style = "line-height: 14px;" t-field="doc.company_id.name"/><br/>
                                <span style = "line-height: 14px;" t-field="doc.company_id.company_registry"/><br/>
                                <span style = "line-height: 14px;" t-field="doc.company_id.vat"/><br/>                               
                                <span style = "line-height: 14px;" t-field="doc.company_id.street"/>
                        		<t t-if = "doc.company_id.city">
                                 	,
                                	<span style = "line-height: 14px;" t-field="doc.company_id.city"/>
                                </t>
                                <t t-if = "doc.company_id.state_id.name">
                                	 ,
                                	<span style = "line-height: 14px;" t-field="doc.company_id.state_id.name"/>
                        		</t>
                                <t t-if = "doc.company_id.zip">
                                 	, C.P 
                                	<span style = "line-height: 14px;" t-field="doc.company_id.zip"/>                                
                                </t>
                        </div>
                        <t t-if = "doc.state == 'draft' or doc.state == 'sent'">
                            <div style="text-align: center; font-size: 20px; font-weight: bold;"> COTIZACIÓN </div>
                        </t>
                        <t t-elif = "doc.state == 'sale' or doc.state == 'done'">
                            <div style="text-align: center; font-size: 20px; font-weight: bold;"> ORDEN DE VENTA </div>
                        </t>
                        <t t-elif = "doc.state == 'cancel'">
                            <div style="text-align: center; font-size: 20px; font-weight: bold;"> CANCELADA </div>
                        </t>
                    
                        <t t-if = "doc.state == 'draft' or doc.state == 'sent'">
                        	<t t-if = "doc.validity_date">
                            	<div style="text-align: left; font-size: 14px;">                             
                            		<br/>
                            		VENCIMIENTO:  <t t-esc = "doc.validity_date and doc.validity_date.strftime('%d/%m/%Y')"/>
                        		</div>
                            </t>
                        </t>
                                   
                        <br/>                                                  
                        <div style="font-size: 13px; text-align: left; width:100%;"><b>Cliente:</b></div> 
                        <div style="font-size: 13px; text-align: left; width:100%;"><t t-esc="doc.partner_id.name"/></div>     
                        <div style="text-align: left; font-size: 13px;">

                                <span style = "line-height: 14px;" t-field="doc.partner_id.street"/>
                                 ,
                                <span style = "line-height: 14px;" t-field="doc.partner_id.neighborhood_id.name"/>
                                 ,                                 
                                <span style = "line-height: 14px;" t-field="doc.partner_id.city"/>
                                 ,
                                <span style = "line-height: 14px;" t-field="doc.partner_id.state_id"/>
                                 , C.P 
                                <span style = "line-height: 14px;" t-field="doc.partner_id.custom_zip"/>                                
                        </div>

                        <div style="margin-top: 0px;">
                            <svg width="100%" height="2" xmlns="http://www.w3.org/2000/svg">
                                <line x1="0" y1="0" x2="100%" y2="0" stroke="black" stroke-width="2"/>
                            </svg>
                        </div>                               
						
                    	<t t-set = "lines_discount" t-value = "0"/>
                        <t t-set = "general_discount" t-value = "0"/>
                    		
                        <table style="width: 100%; text-align: left; border-collapse: collapse; border-style: hidden; border: none; margin-top: -5px;">
                            <!-- Primera fila -->
                            <tr>
                                <th style="width: 30%; padding: 1px; font-size: 13px; border: none; border-collapse: collapse; border-style: hidden;"><b>CLAVE</b></th>
                                <th style="width: 70%; padding: 1px; font-size: 13px; border: none; border-collapse: collapse; border-style: hidden;"><b>DESCRIPCIÓN</b></th>
                            </tr>
                        </table>
                        <!-- Segunda fila -->
                        <table style="width: 100%; text-align: left; border-collapse: collapse; border-style: hidden; border: none;">                
                            <tr>
                                <th style="width: 60%; padding: 1px; font-size: 13px; text-align: left; border: none; border-collapse: collapse; border-style: hidden;"><b>CANTIDAD</b></th>
                                <th style="width: 10%; padding: 1px; font-size: 13px; text-align: right; border: none; border-collapse: collapse; border-style: hidden;"><b>P.U.</b></th>                        
                                <th style="width: 30%; padding: 1px; font-size: 13px; text-align: right; border: none; border-collapse: collapse; border-style: hidden;"><b>IMPORTE</b></th>
                            </tr>
                        </table>

                        <div style="margin-top: -5px;">
                            <svg width="100%" height="2" xmlns="http://www.w3.org/2000/svg">
                                <line x1="0" y1="0" x2="100%" y2="0" stroke="black" stroke-width="2"/>
                            </svg>
                        </div>

                        <tr t-foreach="doc.order_line" t-as="line">
                            <t t-if = "line.price_unit >= 0">
                                <table class="product-first-row" style="width: 100%; text-align: left; border-collapse: collapse; border-style: hidden;">
                                    <tr>
                                        <th style="width: 30%; padding: 1px; font-size: 12px; border: none;" t-field="line.product_id.barcode"></th>
                                        <th style="width: auto; padding: 1px; font-size: 12px; border: none; white-space: nowrap;" t-field="line.product_id"></th>
                                    </tr>                    
                                </table> 
                                <table class="product-second-row" style="width: 100%; text-align: left; border-collapse: collapse; border-style: hidden; margin-top:0px; ">                
                                    <tr>
                                        <th style="width: 25%; padding: 1px; font-size: 12px; border: none;" t-field="line.product_uom_qty"></th>
                                        <th style="width: 25%; padding: 1px; font-size: 12px; text-align: leftt; border: none;">
                                            <t t-if="line.discount != 0">
                                            	<t t-set = "lines_discount" t-value = "lines_discount+(line.price_unit*line.discount/100*line.product_uom_qty)"/>
                                                Desct: <span t-field="line.discount"/>%
                                            </t>
                                        </th>
                                        <th style="width: 25%; padding: 1px; font-size: 12px; text-align: right; border: none;">
                                            <t t-if="line.discount != 0">
                                                <span t-esc="'{0:,.2f}'.format(line.price_unit)"/>
                                                >                                            
                                                <t t-esc= "'{0:,.2f}'.format(line.price_unit*(100-line.discount)/100)"/>
                                            </t>
                                            <t t-else=''>
                                                <span t-esc="'{0:,.2f}'.format(line.price_unit)"/>
                                            </t>
                                        </th>
                                        <th style="width: 25%; padding: 1px; font-size: 12px; text-align: right; border: none;">
                                            <span t-esc = "'{0:,.2f}'.format(line.price_subtotal)"/>
                                        </th>
                                    </tr>                                                        
                                </table>     
                            </t>  
                            <t t-else = "">
                                <t t-if = "line.product_id.name == 'Descuento'">
                                    <t t-set = "general_discount" t-value = "general_discount+(line.price_subtotal*(-1))"/>
                                </t>
                            </t>                              
                        </tr>
                        <div style="margin-top: -5px;">
                            <svg width="100%" height="2" xmlns="http://www.w3.org/2000/svg">
                                <line x1="0" y1="0" x2="100%" y2="0" stroke="black" stroke-width="2"/>
                            </svg>
                        </div>
                    	<t t-if = "general_discount">
                        	<div style="display: inline-block; width: 59%; text-align: right; font-size: 14px;">
                            	SUBTOTAL
                        	</div>
                        	<div style="display: inline-block; width: 39%; text-align: right; font-size: 14px;">
                            	$ <span t-esc="'{0:,.2f}'.format(doc.amount_total+general_discount)"/>
                        	</div>                     	
                        	<div style="display: inline-block; width: 59%; text-align: right; font-size: 14px;">
                        	    DESCUENTO
                            </div>
                        	<div style="display: inline-block; width: 39%; text-align: right; font-size: 14px;">
                            	$ <span t-esc="'{0:,.2f}'.format(-general_discount)"/>
                        	</div>
                        </t>
                        <div style="display: inline-block; width: 59%; text-align: right; font-size: 14px;">
                            TOTAL
                        </div>
                        <div style="display: inline-block; width: 39%; text-align: right; font-size: 14px;">
                            $ <span t-esc="'{0:,.2f}'.format(doc.amount_total)"/>
                        </div>                        
                        <t t-if = "general_discount+lines_discount">
                            <div style="text-align: center; font-size: 14px;">                            	
                            	<br/>
                                USTED AHORRA: 
                                $ <span t-esc="'{0:,.2f}'.format(general_discount+lines_discount)"/>
                            </div>                        
                        </t>
                        <div style = "font-size: 14px; text-align: left; width: 100%;">
                            <br/>                    
                            VENDEDOR: 
                            <t t-set="full_name" t-value="doc.user_id.name"/>
                            <t t-if="full_name">
                                <t t-set="name_parts" t-value="full_name.split(' ')"/>
                                <t t-if="len(name_parts) &gt; 2">
                                    <t t-esc="name_parts[0]"/> <t t-esc="name_parts[1][0]"/>. <t t-esc="name_parts[2][0]"/>.
                                </t>
                                <t t-elif="len(name_parts) &gt; 1">
                                    <t t-esc="name_parts[0]"/> <t t-esc="name_parts[1][0]"/>.
                                </t>
                                <t t-else="">
                                    <t t-esc="full_name"/>
                                </t>
                            </t>
                            <t t-else="">                                
                                <t t-esc="' '"/>
                            </t>
                        </div>
                        <t t-if = "doc.state == 'sale' or doc.state == 'done'">
                        	<div style="font-size: 12px; text-align: center; width: 100%; font-weight: bold;">
                            	<br/>
                            	REVISE SU MERCANCÍA. NO SE ACEPTAN RECLAMOS POR FALTANTES DESPUÉS DE LA ENTREGA.
                            	<br/>
                            	<br/>
                            	RECIBÍ MERCANCÍA COMPLETA
                            	<br/>
                        	</div>                        
                        	<div style="margin-top: 30px;">
                            	<svg width="100%" height="2" xmlns="http://www.w3.org/2000/svg">
                                	<line x1="0" y1="0" x2="100%" y2="0" stroke="black" stroke-width="2"/>
                            	</svg>
                        	</div>  
                        	<div style="font-size: 14px; text-align: center; width: 100%; ">
                            	<t t-esc = "doc.partner_id.name"/>
                        	</div>
                        </t>
                        <div style="font-size: 14px; text-align: center; width: 100%; ">                                                
                            <br/>
                            <b>Folio:</b> <t t-esc = "doc.name"/>
                            <br/>         
                            <b>Fecha:</b> <t t-esc = "doc.date_order and doc.date_order.strftime('%d/%m/%Y')"/>
                        </div>
                        <div style="font-size: 13px; text-align: center; width: 100%; white-space:pre-line; font-weight: bold;  line-height: 15px;">
                            <span style = "line-height: 15px;" t-field="doc.company_id.x_invoice_ticket_footer"/>
                        </div>
                        <div style="font-size: 14px; text-align: center; width: 100%;">
                            <br/>
                            Fecha y hora de impresión: 
                            <t t-esc="datetime.datetime.now(datetime.timezone(datetime.timedelta(hours=-6))).strftime('%d/%m/%Y %H:%M:%S')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
