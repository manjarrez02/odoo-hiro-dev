<odoo>
    <data noupdate="0">
        <record id="paperformat_roll_paper" model="report.paperformat">
            <field name="name">Roll paper</field>
            <field name="default" eval="False"/>
            <field name="format" eval="False"/>
            <field name="page_height">3276</field>
            <field name="page_width">80</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">2</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">10</field>
            <field name="dpi">96</field>
        </record>

        <record id="paperformat_letter_order" model="report.paperformat">
            <field name="name">Letter - Order Ticket</field>
            <field name="default" eval="False"/>
            <field name="format">Letter</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">10</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">10</field>
            <field name="margin_right">10</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">5</field>
            <field name="dpi">90</field>
        </record>
    </data>
</odoo>