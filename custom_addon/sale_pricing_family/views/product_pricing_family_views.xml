<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_pricing_family_tree" model="ir.ui.view">
        <field name="name">product.pricing.family.tree</field>
        <field name="model">product.pricing.family</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_product_pricing_family_form" model="ir.ui.view">
        <field name="name">product.pricing.family.form</field>
        <field name="model">product.pricing.family</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Products">
                            <field name="product_tmpl_ids" context="{'default_pricing_family_id': active_id}">
                                <tree>
                                    <field name="name"/>
                                    <field name="list_price"/>
                                    <field name="sale_ok"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_pricing_family" model="ir.actions.act_window">
        <field name="name">Pricing Families</field>
        <field name="res_model">product.pricing.family</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_product_pricing_family"
              name="Pricing Families"
              parent="stock.menu_stock_config_settings"
              action="action_product_pricing_family"
              sequence="95"/>
</odoo>
