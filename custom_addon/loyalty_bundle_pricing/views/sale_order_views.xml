<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_inherit_bundle_promotions" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.bundle.promotions</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="has_unapplied_promotions" invisible="1" force_save="1"/>
                <field name="promo_dismissed" invisible="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>
