<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_rule_view_form_inherit_bundle" model="ir.ui.view">
        <field name="name">loyalty.rule.view.form.inherit.bundle</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reward_point_mode']/parent::group" position="attributes">
                <attribute name="attrs">{'invisible': [('user_has_debug', '=', False), ('program_type', 'not in', ('loyalty', 'buy_x_get_y', 'bundle_pricing'))]}</attribute>
            </xpath>
            <xpath expr="//field[@name='reward_point_mode']" position="attributes">
                <attribute name="attrs">{'invisible': [('program_type', 'not in', ('promotion', 'promo_code', 'next_order_coupons', 'loyalty', 'buy_x_get_y', 'bundle_pricing'))]}</attribute>
            </xpath>
            <xpath expr="//label[@for='reward_point_amount']" position="attributes">
                <attribute name="attrs">{'invisible': [('program_type', 'not in', ('promotion', 'promo_code', 'next_order_coupons', 'loyalty', 'buy_x_get_y', 'bundle_pricing'))]}</attribute>
            </xpath>
            <xpath expr="//div[field[@name='reward_point_amount']]" position="attributes">
                <attribute name="attrs">{'invisible': [('program_type', 'not in', ('promotion', 'promo_code', 'next_order_coupons', 'loyalty', 'buy_x_get_y', 'bundle_pricing'))]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
