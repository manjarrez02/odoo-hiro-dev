<?xml version="1.0" encoding="UTF-8"?>
	<templates id="bi_pos_stock_template" inherit_id="point_of_sale.template" xml:space="preserve">
		

		<t t-name="BiWarningPopup" owl="1">
			<div role="dialog" class="modal-dialog">
				<Draggable>
					<div class="popup bi-popup-width">
						<header class="title drag-handle" style="background-color: #714B67; color: #fff;height: 20px;">
							Product Out of Stock
						</header>
						<main class="body">
							<br/>
							This Product <b t-esc="props.name"/> is not in stock.Click into the Order button if you still want to add a product.
							<br/>
							<br/>
						</main>
						<footer class="footer" style="background-color: #714B67; color: #fff;">
							<div style="background-color: #009688;color: white;" t-on-click="order" class="button">
								Order
							</div>
							<t t-if = "!props.qty">
								<div class="button cancel odoo-theme-color" t-on-click="cancel" style="background-color: #E0E0E0; color: black;">
									Cancel
								</div>
							</t>
						</footer>
					</div>
				</Draggable>
			</div>
		</t>

		<t t-name="ProductItem" t-inherit="point_of_sale.ProductItem" t-inherit-mode="extension" owl="1">
			<xpath expr="//div[hasclass('product-content')]" position="inside">
				<t t-if="props.product.type != 'consu' and props.product.type != 'service'">
					<t t-if="env.pos.config.show_stock_location == 'specific'">
						<t t-if="env.pos.config.pos_display_stock">
							<t t-if="env.pos.config.pos_stock_type == 'onhand'">
								<t t-if="props.product.qty_available > 0">
									<span class="qty-label">
										<t t-esc="props.product.qty_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label out-of-stock-qty">
										<t t-esc="props.product.qty_available"/>
									</span>
								</t>
							</t>
							<t t-if="env.pos.config.pos_stock_type == 'virtual'">
								<t t-if="props.product.virtual_available > 0">
									<span class="qty-label">
										<t t-esc="props.product.virtual_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label out-of-stock-qty">
										<t t-esc="props.product.virtual_available"/>
									</span>
								</t>
							</t>
							<t t-if="env.pos.config.pos_stock_type == 'both'">
								<t t-if="props.product.qty_available > 0">
									<span class="qty-label">
										<t t-esc="props.product.qty_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label out-of-stock-qty">
										<t t-esc="props.product.qty_available"/>
									</span>
								</t>
								<t t-if="props.product.virtual_available > 0">
									<span class="qty-label1">
										<t t-esc="props.product.virtual_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label1 out-of-stock-qty">
										<t t-esc="props.product.virtual_available"/>
									</span>
								</t>
							</t>
						</t>
						<t t-else="">
							<t t-if="env.pos.config.pos_stock_type == 'onhand'">
								<t t-if="props.product.bi_qty_available > 0">
									<span class="qty-label">
										<t t-esc="props.product.bi_qty_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label out-of-stock-qty">
										<t t-esc="props.product.bi_qty_available"/>
									</span>
								</t>
							</t>

							<t t-if="env.pos.config.pos_stock_type == 'virtual'">
								<t t-if="props.product.bi_virtual_available > 0">
									<span class="qty-label">
										<t t-esc="props.product.bi_virtual_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label out-of-stock-qty">
										<t t-esc="props.product.bi_virtual_available"/>
									</span>
								</t>
							</t>
							<t t-if="env.pos.config.pos_stock_type == 'both'">
								<t t-if="props.product.bi_qty_available > 0">
									<span class="qty-label">
										<t t-esc="props.product.bi_qty_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label out-of-stock-qty">
										<t t-esc="props.product.bi_qty_available"/>
									</span>
								</t>
								<t t-if="props.product.bi_virtual_available > 0">
									<span class="qty-label1">
										<t t-esc="props.product.bi_virtual_available"/>
									</span>
								</t>
								<t t-else="">
									<span class="qty-label1 out-of-stock-qty">
										<t t-esc="props.product.bi_virtual_available"/>
									</span>
								</t>
							</t>
							
						</t>
					</t>

				</t>
			</xpath>
		</t>

	</templates>
	
	
