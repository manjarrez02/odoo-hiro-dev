<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_order_horizontal" inherit_id="purchase.report_purchaseorder_document">
        
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <div class="page" style="width: 100%; max-width: 100%;">
                    
                    <!-- Encabezado del documento -->
                    <div class="row">
                        <div class="col-12">
                            <h4 class="mb-2">Orden de Compra: <span t-field="o.name"/></h4>
                        </div>
                    </div>
                    
                    <!-- Información del proveedor y fechas -->
                    <div class="row">
                        <div class="col-6">
                            <strong>Proveedor:</strong>
                            <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                        </div>
                        <div class="col-6">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Fecha de orden:</strong></td>
                                    <td><span t-field="o.date_order"/></td>
                                </tr>
                                <tr>
                                    <td><strong>Fecha límite:</strong></td>
                                    <td><span t-field="o.date_planned"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="row mt-2">
                    <div class="col-12 mb-3">
                        <div t-if="o.partner_ref">
                                <strong>Referencia proveedor:</strong> <span t-field="o.partner_ref"/>
                            </div>
                        </div>
                    </div>
                    <!-- Tabla horizontal de líneas -->
                    <table class="table table-sm table-po-horizontal" style="width: 100%; table-layout: fixed;">
                        <thead class="table-active">
                            <tr>
                                <th style="width: 10%;">Cantidad</th>
                                <th style="width: 25%;">Producto</th>
                                <th style="width: 12%;">Cantidad empaque</th>
                                <th style="width: 25%;">Empaque</th>
                                <th style="width: 14%;">Precio Unit.</th>
                                <th style="width: 14%;">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.order_line" t-as="line">
                                <!-- Fila de sección/nota -->
                                <t t-if="line.display_type == 'line_section' or line.display_type == 'line_note'">
                                    <td colspan="6" style="background-color: #f8f9fa; font-weight: bold;">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                                <!-- Fila normal de producto -->
                                <t t-else="">
                                    <td class="text-right">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.name"/>
                                        <div t-if="line.product_id.barcode">
                                            [<span t-field="line.product_id.barcode"/>]
                                        </div>
                                        <div t-if="line.product_supplier_code">
                                            CP: [<span t-field="line.product_supplier_code"/>]
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.product_packaging_qty"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_packaging_id.name"/>
                                        <div t-if="line.product_packaging_id.barcode">
                                            [<span t-field="line.product_packaging_id.barcode"/>]
                                        </div>                                     
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                    
                    <!-- Totales -->
                    <div class="row mt-3 justify-content-end">
                        <div class="col-5">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Subtotal:</strong></td>
                                    <td class="text-right">
                                        <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Impuestos:</strong></td>
                                    <td class="text-right">
                                        <span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-top">
                                    <td><strong>Total:</strong></td>
                                    <td class="text-right">
                                        <span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Notas / Términos -->
                    <div t-if="o.notes" class="mt-3">
                        <strong>Notas:</strong>
                        <div t-field="o.notes"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>