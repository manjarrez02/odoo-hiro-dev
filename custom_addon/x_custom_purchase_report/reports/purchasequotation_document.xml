<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="purchase_quotation_horizontal" inherit_id="purchase.report_purchasequotation_document">
        
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <div class="page" style="width: 100%; max-width: 100%;">
                    
                    <!-- Encabezado del documento -->
                    <div class="row">
                        <div class="col-12">
                            <h4 class="mb-2">Solicitud de Cotización: <span t-field="o.name"/></h4>
                        </div>
                    </div>
                    
                    <!-- Información del proveedor y fechas -->
                    <div class="row">
                        <div class="col-6">
                            <strong>Proveedor:</strong>
                            <div t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                        </div>
                        <div class="col-6">
                            <table class="table table-sm table-borderless">
                                <tr>
                                    <td><strong>Fecha de solicitud:</strong></td>
                                    <td><span t-field="o.date_order"/></td>
                                </tr>
                                <tr t-if="o.date_planned">
                                    <td><strong>Fecha esperada:</strong></td>
                                    <td><span t-field="o.date_planned"/></td>
                                </tr>
                            </table>
                        </div>
                    </div>                
                    
                    <!-- Tabla horizontal de líneas -->
                    <table class="table table-sm table-bordered" style="width: 100%; table-layout: fixed;">
                        <thead class="table-active">
                            <tr>
                                <th style="width: 12%;">Cantidad</th>
                                <th style="width: 38%;">Descripción Interna</th>
                                <th style="width: 12%;">Cant. Empaque</th>          
                                <th style="width: 38%;">Descripción Proveedor</th>              
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="o.order_line" t-as="line">
                                <!-- Fila de sección/nota -->
                                <!-- Fila de sección -->
                                <t t-if="line.display_type == 'line_section'">
                                    <td colspan="5" style="background-color: #f8f9fa; font-weight: bold;">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                                
                                <!-- Fila de nota -->
                                <t t-elif="line.display_type == 'line_note'">
                                    <td colspan="5" style="background-color: #f8f9fa;">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                                <!-- Fila normal de producto -->
                                <t t-else="">
                                    <td class="text-right">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.name"/>
                                        <div t-if="line.product_id.barcode">
                                            [<span t-field="line.product_id.barcode"/>]
                                        </div>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.product_packaging_qty"/>
                                    </td>                                    
                                    <td>
                                        <span t-field="line.product_supplier_name"/>
                                        <div t-if="line.product_supplier_code">
                                            [<span t-field="line.product_supplier_code"/>]
                                        </div>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>
                    
                    <!-- Notas / Términos -->
                    <div t-if="o.notes" class="mt-3">
                        <strong>Notas:</strong>
                        <div t-field="o.notes"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>