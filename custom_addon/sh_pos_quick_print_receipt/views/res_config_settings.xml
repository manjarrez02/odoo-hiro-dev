<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sh_quick_print_receipt_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">sh.quick.print.receipt.res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="pos_interface_section" position="after">
                <h2>POS Quick Receipt Print</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-xs-6 col-md-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="pos_sh_is_quick_receipt_print" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="pos_sh_is_quick_receipt_print" />
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>