<?xml version="1.0" encoding="UTF-8"?>
	<templates id="pos_all_in_one_template" inherit_id="point_of_sale.template" xml:space="preserve">
		<t t-name="UserPaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension" owl="1">
			<xpath expr="//div[hasclass('paymentmethods')]" position="replace">
				<div class="paymentmethods">
					<p class="title-category">Payment method</p>
					<t t-foreach="payment_methods_from_config" t-as="paymentMethod"
					   t-key="paymentMethod.id">
						<t t-if="paymentMethod.user_ids.includes(env.pos.user.id)">
							<div class="button paymentmethod"
								t-on-click="() => this.trigger('new-payment-line', paymentMethod)">
								<div class="payment-name">
									<t t-esc="paymentMethod.name" />
								</div>
							</div>
						</t>
					</t>
				</div>
			</xpath>
		</t>
</templates>
