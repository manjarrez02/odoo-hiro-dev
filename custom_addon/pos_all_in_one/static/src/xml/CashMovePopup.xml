<?xml version="1.0" encoding="UTF-8"?>
<templates id="pos_new_view_template" inherit_id="point_of_sale.template" xml:space="preserve">
	<t t-name="BiCashMovePopup" t-inherit="point_of_sale.CashMovePopup" t-inherit-mode="extension" owl="1">
		<xpath expr="//div[hasclass('dynamic-size')]" position="replace">
			<div class="button confirm disable highlight dynamic-size" t-on-click="confirm">
	            Confirm / Print (<span t-esc="env.pos.format_currency(state.parsedAmount)"/>)
	        </div>
		</xpath> 
	</t>
</templates>