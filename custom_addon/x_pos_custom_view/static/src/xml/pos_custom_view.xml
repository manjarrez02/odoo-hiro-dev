<?xml version="1.0" encoding="UTF-8"?>

    <templates id="x_pos_custom_views" xml:space="preserve">

        <t t-name="ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension" owl="1">
            <xpath expr="//t[@t-if='env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_payments']" position="replace">
                <t t-if="env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_payments and props.actionToTrigger != 'do-refund'">	
                    <button class="button pay validation" t-on-click="() => this.trigger(props.actionToTrigger or 'click-pay')">
                        <div class="pay-circle" t-att-class="{ 'highlight': props.isActionButtonHighlighted }">
                            <i class="fa fa-chevron-right" role="img" aria-label="Pay" title="Pay" />
                        </div>
                        <t t-esc="props.actionName" />
                    </button>
                </t>
                <t t-elif="env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_refund and props.actionToTrigger == 'do-refund'">	
                    <button class="button pay validation" t-on-click="() => this.trigger(props.actionToTrigger or 'click-pay')">
                        <div class="pay-circle" t-att-class="{ 'highlight': props.isActionButtonHighlighted }">
                            <i class="fa fa-chevron-right" role="img" aria-label="Pay" title="Pay" />
                        </div>
                        <t t-esc="props.actionName" />
                    </button>
                </t>

            </xpath>

                <xpath expr = "//t[@t-if='env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_customer_selection']" position = "replace">
                    <t t-if="env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_customer_selection">
                        <button class="button set-partner" t-att-class="{'decentered': isLongName}"
                                t-on-click="() => this.trigger('click-partner')">
                            <t t-if="!env.isMobile"><i class="fa fa-user" role="img" aria-label="Customer" title="Customer" /></t>
                            <t t-if="props.partner">
                                <t t-esc="props.partner.name" />
                                <span>
                                    <t t-if="props.partner.allow_over_limit">
                                        <t t-set = "available_credit" t-value = "(props.partner.limit_credit - props.partner.bi_total_credit_amount)"/>
                                        <t t-if = "available_credit > 0">
                                            <br/>
                                            [Credit: 
                                            <t t-esc="available_credit.toFixed(2)"/>
                                            ]
                                        </t>
                                        <t t-else="">
                                            <br/>
                                            [Credit: 
                                            <t t-esc="'0'"/>
                                            ]
                                        </t>
                                    </t>
                                    <t t-if = "props.partner.wallet_balance">
                                        <br/>
                                        [e-Wallet:
                                        <t t-esc="(props.partner.wallet_balance).toFixed(2)"/>
                                        ]
                                    </t>

                                </span>
                            </t>
                            <t t-else="">
                                Customer
                            </t>
                        </button>
                    </t>                
            </xpath>
        </t>

        <t t-name="Chrome" t-inherit="point_of_sale.Chrome" t-inherit-mode="extension" owl="1">  
              <xpath expr = "//div[@class = 'pos-branding']//img[@class = 'pos-logo']" position = "replace">
                <img t-if="!env.isMobile" class="pos-logo" t-on-click="() => this.trigger('toggle-debug-widget')"
                    src="/x_pos_custom_view/static/img/hiro-logo.png" alt="Logo" />
            </xpath>                   
        </t>

        <t t-name="CashierName" t-inherit="point_of_sale.CashierName" t-inherit-mode="extension" owl="1">  
            <xpath expr = "//div[@class = 'oe_status']//span[1]" position = "before">
                Usuario: 
            </xpath>  
        </t>

        <t t-name="TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension" owl="1">  
            <xpath expr = "//div[@class = 'pads']" position = "replace">
                <t t-if="env.pos.get_cashier().is_allow_refund">
                <div class="subpads" style="display: flex;">
                    <div style="flex: 1;">
                        <ActionpadWidget partner="getSelectedPartner()" actionName="constructor.numpadActionName" actionToTrigger="'do-refund'" isActionButtonHighlighted="getHasItemsToRefund()" />
                    </div>
                    <div style="flex: 1;">
                        <NumpadWidget disabledModes="['price', 'discount']" activeMode="_selectedOrderlineId and 'quantity'" disableSign="true" />
                    </div>
                </div>
                </t>                
            </xpath>  
        </t>

        <t t-name="PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension" owl="1">  
            <xpath expr = "//button[@class = 'edit-partner-button']" position = "replace">

            </xpath>  
         
            <xpath expr = "//td[@class = 'order-partner-order']" position = "replace">

            </xpath>  
        </t>

        <t t-name="ProductItem" t-inherit="point_of_sale.ProductItem" t-inherit-mode="extension" owl="1">

            <xpath expr = "//t[@t-if='props.product.image_128']" position = "replace">
                <t t-if="props.product.image_128">
                    <div class="product-img">
                        <img t-att-src="imageUrl" t-att-alt="props.product.display_name" />
                    </div>
                </t>
                <t t-else ="">
                    <div class="product-img">
                        <img src="/x_pos_custom_view/static/img/papeleria.webp" t-att-alt="props.product.display_name" />
                    </div>
                </t>                
            </xpath>
            <xpath expr = "//t[@t-else=''][3]//div//span//t[@t-esc='price']" position = "replace">
                    <span class="price-tag">
                    	<t t-set="price_string" t-value="price"/>
	                    <t t-set="integer_part" t-value="price_string.split('.')[0]" />
                        <t t-set="decimal_part1" t-value="price_string.split('.')[1][0]" />
                        <t t-set="decimal_part2" t-value="price_string.split('.')[1][1]" />
	                    <t t-esc="integer_part"/>.<t t-esc="decimal_part1"/><t t-esc="decimal_part2"/>
	                </span>
            </xpath>

        </t>        

        <t t-name="POSOrdersScreen" t-inherit="pos_orders_all.POSOrdersScreen" t-inherit-mode="extension" owl="1">  
            <xpath expr = "//th[@class='returnorder']" position = "replace">
                <t t-if = "env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_refund">
                    <th class="returnorder">Return-Order</th>
                </t>
            </xpath>

            <xpath expr = "//t[@t-if='env.pos.config.allow_partical_payment']" position = 'replace'>
                <t t-if="env.pos.config.allow_partical_payment">
					<th>Amount Due</th>
                    <t t-if="env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_payments">                   
    					<th>Pay</th>
                    </t>
				</t>
            </xpath>   
        </t>

        <t t-name="POSOrders" t-inherit="pos_orders_all.POSOrders" t-inherit-mode="extension" owl="1">  
            <xpath expr = "//td[@class='Return-order']" position = "replace">
                <t t-if = "env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_refund">
                    <t t-if="props.order.state != 'draft'">
                        <td class="Return-order">
                            <button class="odoo-theme-button" t-on-click.stop="() => this.props.onClickReturnOrder(props.order)"><i class="fa fa-sign-in"></i>  Return Order</button>
                        </td>
                    </t>
                    <t t-else="">
                        <span> - </span>
                    </t>
                </t>
            </xpath>

            <xpath expr = "//td[@class='order-pay']" position = "replace">
                <t t-if = "env and env.pos and env.pos.get_cashier() and env.pos.get_cashier().is_allow_payments">
					<td  class='order-pay' t-att-data-id='props.order.id' 
					t-on-click.stop="() => this.trigger('click-pay', props.order)">
						<t t-if="props.order.state == 'draft'">
							<button class="odoo-theme-button" t-att-id='props.order.id' ><i class="fa fa-credit-card"></i> Pay</button>
						</t>
						<t t-else="">
							<span> - </span>
						</t>
					</td>
                </t>
            </xpath>            
        </t>
