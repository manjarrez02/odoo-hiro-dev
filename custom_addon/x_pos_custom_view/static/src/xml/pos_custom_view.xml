        <t t-name="RegisterInvoicePaymentPopupWidget" t-inherit="pos_all_in_one.RegisterInvoicePaymentPopupWidget" t-inherit-mode="extension" owl="1">
            <xpath expr = "//div[@class='body']" position = "replace">
				<div class="body">
					<p>Enter Payment Details Here</p><br/>
					<div style="text-align: left; margin-left: 37px;">
						<label style="text-align:left"> Payment Journal:  </label>
						<select id="payment_type1" class='detail' name='type' style="height: 35px;width: 59%;float: right;   margin-right: 6%;">

								<t t-foreach='payment_methods_from_config' t-as='payment_method' t-key="payment_method.id">
									<t t-if="payment_method.user_ids.includes(env.pos.user.id)">
										<option t-att-value='payment_method.journal_id[0]'> 
											<t t-esc='payment_method.journal_id[1]'/>
										</option>
									</t>
								</t>

						</select>
					</div><br/>
					<div style="text-align: left; margin-left: 37px;">
						<label style="text-align:left"> Amount:  </label><input id ="entered_amount1" type="text" class="input-field" name="code" style="height: 35px;width: 59%;float: right;   margin-right: 6%;" t-att-value="env.pos.format_currency_no_symbol(invoice.amount_residual)"> </input>
					</div><br/>
					<div style="text-align: left; margin-left: 37px;margin-top: 2%;">
						<label style="text-align:left"> Payment Note:  </label><input id ="entered_note1" type="text" class="input-field" name="code" style="height: 35px;width: 59%;float: right;   margin-right: 6%;"></input>
					</div>
				</div>                
            </xpath>
        </t>

        <t t-name="PartnerListScreen" t-inherit="point_of_sale.PartnerListScreen" t-inherit-mode="extension" owl="1">
            <xpath expr="//div[@class='button new-customer highlight']" position="replace">
                <div></div>
            </xpath>
        </t>

        <t t-name="ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="extension" owl="1">
            <xpath expr="//div[@class='popup product-info-popup']" position="replace">
                <div class="popup product-info-popup">
                    <header class="title">
                        Product information
                    </header>
                    <main class="body">
                        <div class="section-product-info-title">
                            <div class="column flex-start">
                                <span t-esc="props.product.display_name" class="global-info-title product-name"/>
                                <span><t t-if="props.product.default_code" t-esc="props.product.default_code"/> <t t-if="props.product.default_code and props.product.barcode"> - </t> <t t-if="props.product.barcode" t-esc="props.product.barcode"/></span>
                            </div>
                            <div class="column flex-end">
                                <span t-esc="env.pos.format_currency(productInfo.all_prices.price_with_tax)" class="global-info-title" />
                                <t t-foreach="productInfo.all_prices.tax_details" t-as="tax" t-key="tax.name">
                                    <div><t t-esc="tax.name"/>: <t t-esc="env.pos.format_currency(tax.amount)"/></div>
                                </t>
                            </div>
                        </div>
                        <div class="section-financials">
                            <div class="section-title">
                                <span>Financials</span>
                                <div class="section-title-line"></div>
                            </div>
                            <div class="section-financials-body">
                                <table>
                                    <tr>
                                        <td>Precio de lista:</td>
                                        <td><t t-esc="env.pos.format_currency(productInfo.all_prices.price_with_tax)"/></td>
                                    </tr>
                                </table>
                                <t t-if = "productInfo.pricelists.length > 0">
                                    <table>
                                        <t t-foreach="productInfo.pricelists" t-as="pricelist" t-key = "pricelist">
                                            <tr>                         
                                                <td>
                                                    A partir de <t t-esc = "pricelist.min_quantity"/>: 
                                                </td>
                                                <td>
                                                    <t t-esc = "env.pos.format_currency(pricelist.fixed_price)"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </table>
                                </t>
                            </div>
                        </div>
                        <div class="section-inventory" t-if="productInfo.warehouses.length > 0">
                            <div class="section-title">
                                <span>Inventory <t t-if="env.pos.pos_session.update_stock_at_closing">(as of opening)</t></span>
                                <div class="section-title-line"></div>
                            </div>
                            <div class="section-inventory-body">
                                <table class="mobile-table">
                                    <t t-foreach="productInfo.locations" t-as="location" t-key="location.name">
                                        <tr>
                                            <td><span class="table-name"><t t-esc="location.warehouse_name"/> / <t t-esc="location.name"/></span>:</td>
                                            <td><t t-esc="location.available_quantity"/> <t t-esc="location.uom"/> available,</td>
                                        </tr>
                                    </t>
                                </table>
                            </div>
                        </div>
                        <div class="extra"/> 
                    </main>
                    <footer class="footer">
                        <div class="button cancel" t-on-click="cancel">
                            Close
                        </div>
                    </footer>
                </div>
            </xpath>
        </t>

        <t t-name="CreateSale" t-inherit="pos_all_in_one.CreateSale" t-inherit-mode="extension" owl="1">
            <xpath expr = "//span[@class='control-button create_so odoo-theme-color']" position = "replace">            
                <span class="control-button create_so odoo-theme-color">
                    <i class="fa fa-shopping-cart" title="Create Sales Order"></i> 
                    <br/><span>Crear Orden</span>
                </span>
            </xpath>
        </t>

        <t t-name="CreateDraftPOS" t-inherit="pos_all_in_one.CreateDraftPOS" t-inherit-mode="extension" owl="1">
            <xpath expr = "//span[@class='control-button pos_bag odoo-theme-color']" position = "replace">            
                <span class="control-button pos_bag odoo-theme-color">
                    <i class="fa fa-file" title="Draft Order"></i>
                    <br/><span>Crear Pedido</span>
                </span>
            </xpath>
        </t>

        <t t-name="OpenSOButton" t-inherit="pos_all_in_one.OpenSOButton" t-inherit-mode="extension" owl="1">
            <xpath expr = "//span[@class='control-button import_so odoo-theme-color']" position = "replace">            
                <span class="control-button import_so odoo-theme-color" >
                    <i class="fa fa-university" title="Sale Orders"></i>
                    <br/><span>Ver Ordenes</span>
                </span>
            </xpath>
        </t>

        <t t-name="OrderlineCustomerNoteButton" t-inherit="pos_all_in_one.OrderlineCustomerNoteButton" t-inherit-mode="extension" owl="1">
            <xpath expr = "//div[@class='control-button']" position = "replace">            
                <div class="control-button">
                    <i class="fa fa-sticky-note" title="Customer Note"/>
                    <br/><span>Notas</span>
                </div>
            </xpath>
        </t>

        <t t-name="ProductInfoButton" t-inherit="pos_all_in_one.ProductInfoButton" t-inherit-mode="extension" owl="1">
            <xpath expr = "//div[@class='control-button']" position = "replace">            
                <div class="control-button">
                    <i class="fa fa-info-circle" role="img" aria-label="Info" title="Info"/>
                    <br/><span>Info</span>
                </div>
            </xpath>
        </t>        

        <t t-name="FastRemoveOrderline" t-inherit="bi_remove_pos_lines.FastRemoveOrderline" t-inherit-mode="extension" owl="1">
            <xpath expr = "//span[@class='control-button js_fastremoveorderline']" position = "replace">         
                <span class="control-button js_fastremoveorderline">
                    <i class="fa fa-trash-o"></i>
                    <br/><span>Borrar Todo</span>
                </span>
            </xpath>
        </t>     

        <t t-name="UnpaidOrderSearchButton" t-inherit="pos_all_in_one.UnpaidOrderSearchButton" t-inherit-mode="extension" owl="1">
            <xpath expr = "//span[@class='control-button pos_bag odoo-theme-color']" position = "replace">         
                <span class="control-button pos_bag odoo-theme-color">
                    <i class="fa fa-search" title="Find Order"></i>
                    <br/><span>Pagar Orden</span>
                </span>
            </xpath>
        </t>       

        <t t-name="SeeAllInvoicesButtonWidget" t-inherit="pos_all_in_one.SeeAllInvoicesButtonWidget" t-inherit-mode="extension" owl="1">
            <xpath expr = "//div[@class='control-button odoo-theme-color']" position = "replace">         
                <div class="control-button odoo-theme-color">
                    <i class="fa fa-credit-card-alt" title="Invoice"></i>
                    <br/><span>Facturas</span>
                </div>
            </xpath>
        </t>       

    </templates> 

    